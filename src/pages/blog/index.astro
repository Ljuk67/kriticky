---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getVisibleSortedBlogPosts, withBlogThumbs } from '../../lib/blog';
import { tagToSlug } from '../../lib/slug';

const posts = await getVisibleSortedBlogPosts();
const enhanced = await withBlogThumbs(posts);

// Compute categories with at least one post
const catCounts = new Map<string, number>();
for (const p of posts) {
  const cats = Array.isArray(p.data.categories) ? p.data.categories : [];
  for (const c of cats) catCounts.set(c, (catCounts.get(c) ?? 0) + 1);
}
const allCategories = [...catCounts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'sk'));
---

<!doctype html>
<html lang="sk">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* This row sits in a text-center wrapper; render it inline-flex so it
			   stays centered as a group instead of stretching full width. */
			.category-filter { display: inline-flex; }
		</style>
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 archive">
			<h1 class="text-center">Všetky články o kritickom myslení v praxi</h1>
			{allCategories.length > 0 && (
				<div class="mt-3 mb-6 text-center">
					<ul class="pill-row category-filter" aria-label="Kategórie">
						{allCategories.map(([c, count]) => (
							<li>
								<a class="pill pill-category" href={`/categories/${tagToSlug(c)}/`}>{c} <span class="pill-count">({count})</span></a>
							</li>
						))}
					</ul>
				</div>
			)}
			<section>
				<ul class="grid grid-cols-1 sm:grid-cols-2 gap-8 list-none p-0 m-0">
					{
						enhanced.map((post, i) => (
							<li class={['glass','rounded-[14px]', i === 0 ? 'sm:col-span-2 p-4' : 'p-3'].join(' ')}>
								<a class="block group no-underline" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
									<img class="post-thumb w-full h-auto rounded-[14px] mb-2 max-sm:hidden" src={post.thumb} alt="" loading="lazy" decoding="async" />
									<h2 class={['posttitle', i === 0 ? 'text-[1.6em] font-semibold' : 'text-[1.1em]'].join(' ')}>{post.data.title}</h2>
									<p class="post-description text-sm mb-1 text-[rgb(var(--black))]">{post.data.description}</p>
									<div class="date text-gray-500 text-sm">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div class="text-sm meta text-gray-500">Autor: {post.data.author}</div>
								</a>
								{Array.isArray(post.data.tags) && post.data.tags.length > 0 && (
									<div class="pill-row mt-2" aria-label="Značky">
										{post.data.tags.map((t) => <a class="pill pill-tag" href={`/tags/${tagToSlug(t)}/`}>{t}</a>)}
									</div>
								)}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
